# ── Required ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Dashboard auth ──────────────────────────────────────────────────────
# Leave blank to disable auth (local dev). Set a strong password in production.
DASHBOARD_PASSWORD=changeme

# ── Storage ─────────────────────────────────────────────────────────────
# Override to /data when using a Railway persistent volume.
DATA_DIR=data

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_TO=you@gmail.com
# Must be a Resend-verified domain address. Use onboarding@resend.dev for testing.
EMAIL_FROM=onboarding@resend.dev
EMAIL_PROVIDER=resend

# ── Brief settings (optional) ──────────────────────────────────────────
NUM_OPTIONS=3
DEDUPE_WINDOW_DAYS=21
MAX_STORY_AGE_HOURS=72

# ── Standalone agent (agent.py) ────────────────────────────────────────
# Comma-separated topics to force (skips auto-discovery)
TOPICS_OVERRIDE=

# ── Dashboard (dashboard.py) ────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
